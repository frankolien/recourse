<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (INFOPLIST_FILE + GENERATE_INFOPLIST_FILE).
	     The recourse:// scheme is the fallback path from the web /pay page when the
	     universal link did not open the app directly. -->
	<!-- Only Apple OS TLS and digital signatures are used, both export-exempt;
	     declaring it here stops App Store Connect asking per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Branded splash: paper background with the Recourse mark, matching the
	     white-and-green onboarding the app opens into. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.recourse.buyer.checkout</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>recourse</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
