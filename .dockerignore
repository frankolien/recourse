# Keep the build context small. Two images build from this root: the backend
# (backend/ plus deployments/) and the agent attestor (engine/src, engine/scripts
# plus deployments/). Everything neither needs is excluded.
**/target
**/node_modules
**/.next
**/.env
**/.env.local
**/evidence-store
web
ios
docs
engine/test
engine/dist
ops
.git
*.log
