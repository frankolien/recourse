# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# Node / TypeScript
node_modules/
dist/
.next/
*.tsbuildinfo

# Rust
target/

# Mobile generated output and local Xcode state
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
mobile/Recourse/Generated/Deployment.swift
mobile/*.xcworkspace/
mobile/xcuserdata/
mobile/**/xcuserdata/
mobile/DerivedData/

# Env and secrets (testnet throwaways still never get committed)
.env
.env.*
!.env.example

# Local demo state
data/evidence/

# Codegen outputs and local dry-run deployments (regenerated per deploy; the real
# deployments/arc-testnet.json is committed after an Arc deploy).
deployments/local-*.json
deployments/seed-local-*.json
engine/src/addresses.ts

# Symlink into web/node_modules so ops scripts resolve viem (a symlink, so the
# directory-only node_modules/ pattern above misses it)
ops/node_modules

# Raw screenshot originals; the resized copies live in web/public/app
web/assets/

# Raw wallet card art originals; the app copies live in Images.xcassets
/assets/

# OS
.DS_Store

# Backend evidence blob store (user data, not committed)
evidence-store/
backend/evidence-store/

# Backend order store: merchant order manifests and product images (user data)
order-store/
backend/order-store/

# Apple authentication private keys. Keep only documentation in this directory.
backend/secrets/*
!backend/secrets/README.md
.vercel
